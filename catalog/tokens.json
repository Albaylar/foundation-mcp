{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "brand": { "$type": "color", "$value": "#0B6E99", "$description": "Primary accent; buttons, links, selected state" },
    "brand-strong": { "$type": "color", "$value": "#084F70" },
    "surface": { "$type": "color", "$value": "#FFFFFF" },
    "surface-2": { "$type": "color", "$value": "#F3F5F7" },
    "text-1": { "$type": "color", "$value": "#15202B" },
    "text-2": { "$type": "color", "$value": "#5B6B7A" },
    "line": { "$type": "color", "$value": "#D9DFE5" },
    "danger": { "$type": "color", "$value": "#B3261E" },
    "on-brand": { "$type": "color", "$value": "#FFFFFF" }
  },
  "type": {
    "title": { "$type": "typography", "$value": { "fontFamily": "system", "fontSize": "28", "fontWeight": "700", "lineHeight": "34" } },
    "body": { "$type": "typography", "$value": { "fontFamily": "system", "fontSize": "17", "fontWeight": "400", "lineHeight": "22" } },
    "label": { "$type": "typography", "$value": { "fontFamily": "system", "fontSize": "15", "fontWeight": "600", "lineHeight": "20" } },
    "caption": { "$type": "typography", "$value": { "fontFamily": "system", "fontSize": "13", "fontWeight": "400", "lineHeight": "18" } }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4" },
    "2": { "$type": "dimension", "$value": "8" },
    "3": { "$type": "dimension", "$value": "12" },
    "4": { "$type": "dimension", "$value": "16" },
    "5": { "$type": "dimension", "$value": "24" },
    "6": { "$type": "dimension", "$value": "32" }
  },
  "radius": {
    "field": { "$type": "dimension", "$value": "10" },
    "card": { "$type": "dimension", "$value": "14" },
    "pill": { "$type": "dimension", "$value": "999" }
  },
  "motion": {
    "fast": { "$type": "duration", "$value": "150ms" },
    "base": { "$type": "duration", "$value": "250ms" }
  }
}
